// Consolidated Firestore security rules for the Achados e Perdidos app.

rules_version = '2';

service cloud.firestore {
  // ------------------------------------------------------------
  // Helpers: keep account domains aligned with the app's email validation.
  // ------------------------------------------------------------
  function isServer() {
    return request.auth != null
      && request.auth.token.email is string
      && request.auth.token.email.matches('^[^@]+@([a-z0-9-]+\\.)?ifpe\\.edu\\.br$')
      && !request.auth.token.email.matches('^[^@]+@discente\\.ifpe\\.edu\\.br$');
  }

  function isStudent() {
    return request.auth != null
      && request.auth.token.email is string
      && request.auth.token.email.matches('^[^@]+@discente\\.ifpe\\.edu\\.br$');
  }

  // ------------------------------------------------------------
  // Helper: does the request attempt to modify any administrative
  // fields that control the lifecycle of an item?
  // ------------------------------------------------------------
  function changesItemStatus() {
    return request.resource.data.diff(resource.data).affectedKeys().hasAny([
      'type',
      'foundAtDaeeAt',
      'foundAtDaeeBy',
      'status',
      'recoveredAt',
      'recoveredByUid',
      'recoveredByName',
      'recoveredByEmail',
      'recoveredByPhotoUrl',
      'pickedUpBy',
      'pickedUpAt',
      'pickupRegisteredBy'
    ]);
  }

  // ------------------------------------------------------------
  // Helper: allowed administrative transitions, only for servers.
  //   1) lost → found   (type changes, foundAtDaeeAt, foundAtDaeeBy)
  //   2) found → recovered (type, status, recoveredAt, recoveredBy... )
  // ------------------------------------------------------------
  function allowedStatusTransition() {
    return (
      // lost → found (any authenticated user)
      (resource.data.type == 'lost'
        && request.resource.data.type == 'found'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'foundAtDaeeAt', 'foundAtDaeeBy'
        ])
        && request.resource.data.foundAtDaeeAt == request.time
        && request.resource.data.foundAtDaeeBy == request.auth.uid)
      // found → recovered (only SERVER accounts)
      || (isServer()
        && resource.data.type == 'found'
        && request.resource.data.type == 'recovered'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'status', 'recoveredAt', 'recoveredByUid', 'recoveredByName', 'recoveredByEmail', 'recoveredByPhotoUrl'
        ])
        && request.resource.data.status == 'recovered'
        && request.resource.data.recoveredAt == request.time
        && request.resource.data.recoveredByUid == request.auth.uid
        && request.resource.data.recoveredByName is string
        && request.resource.data.recoveredByName.size() > 0
        && request.resource.data.recoveredByName.size() <= 100
        && request.resource.data.recoveredByEmail == request.auth.token.email
        && request.resource.data.recoveredByPhotoUrl is string
        && request.resource.data.recoveredByName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('name', '')
        && request.resource.data.recoveredByPhotoUrl == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('photoUrl', '')
      )
    );
  }

  match /databases/{database}/documents {
    // ----------------------------------------------------------------
    // Profiles – owners can read all profiles, but can only write their own.
    // ----------------------------------------------------------------
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'type', 'itemId', 'itemName', 'commentId', 'title', 'body',
            'actorId', 'actorName', 'createdAt', 'read'
          ])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
          && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.userId == userId
          && userId != request.auth.uid
          && (
            (request.resource.data.type == 'item_found'
              && request.resource.data.title == 'Seu item foi encontrado'
              && request.resource.data.itemName is string
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.type == 'found'
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.foundAtDaeeBy == request.auth.uid)
            || (request.resource.data.type == 'item_recovered'
              && request.resource.data.title == 'Seu item foi recuperado'
              && request.resource.data.itemName is string
              && isServer()
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.type == 'recovered'
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.recoveredByUid == request.auth.uid)
            || (request.resource.data.type == 'new_comment'
              && request.resource.data.title == 'Novo comentário no seu item'
              && request.resource.data.itemName is string
              && existsAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId))
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.userId == request.auth.uid)
            || (request.resource.data.type == 'comment_reply'
              && request.resource.data.title == 'Responderam ao seu comentário'
              && request.resource.data.commentId is string
              && existsAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId))
              && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.userId == userId
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.replies.size()
                == get(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.get('replies', []).size() + 1
              && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.replies[
                getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)/comments/$(request.resource.data.commentId)).data.replies.size() - 1
              ].userId == request.auth.uid)
          );
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ----------------------------------------------------------------
    // Items – read for authenticated users. Students may create lost items,
    // SERVER accounts may create found or lost items, and owners may edit
    // non-status fields.
    // ----------------------------------------------------------------
    match /items/{itemId} {
      allow read: if request.auth != null;

      // CREATE ----------------------------------------------------------
      // Students may create lost items; SERVER accounts may create lost or found items.
      // The creator's UID must match the supplied userId field.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.type == 'lost' || request.resource.data.type == 'found')
        && (isServer() || (isStudent() && request.resource.data.type == 'lost'));

      // UPDATE ----------------------------------------------------------
      // • Owners can modify any field *except* the administrative status fields.
      // • SERVER accounts may perform the defined status transitions.
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','location','category','eventDateStart','eventDateEnd','imageUrl']))
        || allowedStatusTransition()
      );

      // DELETE ----------------------------------------------------------
      // Only SERVER accounts may delete items.
      allow delete: if request.auth != null && isServer();

      // ----------------------------------------------------------------
      // Sub‑collection: recoveryDetails – only SERVER accounts may create the
      // single "claimant" document, and it is read‑only for everyone else.
      // ----------------------------------------------------------------
      match /recoveryDetails/{detailId} {
        allow read: if request.auth != null && (
          isServer()
          || get(/databases/$(database)/documents/items/$(itemId)).data.userId == request.auth.uid
        );
        allow create: if isServer()
          && detailId == 'claimant'
          && request.resource.data.keys().hasOnly(['name', 'class', 'enrollment', 'recordedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.class is string && request.resource.data.class.size() > 0 && request.resource.data.class.size() <= 30
          && request.resource.data.enrollment is string && request.resource.data.enrollment.size() > 0 && request.resource.data.enrollment.size() <= 40
          && request.resource.data.recordedAt == request.time
          && get(/databases/$(database)/documents/items/$(itemId)).data.type == 'found'
          && get(/databases/$(database)/documents/items/$(itemId)).data.get('status', 'active') != 'recovered';
        allow update, delete: if false;
      }

      // ----------------------------------------------------------------
      // Sub‑collection: comments – any authenticated user can read; only the
      // author can create a comment; only the author can append a single reply.
      // ----------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['userId', 'authorName', 'authorPhotoUrl', 'text', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 100
          && request.resource.data.authorPhotoUrl is string
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null
          && request.resource.data.keys().hasOnly(['replies'])
          && request.resource.data.replies is list
          && request.resource.data.replies.size() == resource.data.get('replies', []).size() + 1
          && request.resource.data.replies.hasAll(resource.data.get('replies', []))
          && request.resource.data.replies[request.resource.data.replies.size() - 1].keys().hasOnly([
            'userId', 'authorName', 'authorPhotoUrl', 'text', 'createdAt'
          ])
          && request.resource.data.replies[request.resource.data.replies.size() - 1].userId == request.auth.uid
          && request.resource.data.replies[request.resource.data.replies.size() - 1].authorName is string && request.resource.data.replies[request.resource.data.replies.size() - 1].authorName.size() > 0 && request.resource.data.replies[request.resource.data.replies.size() - 1].authorName.size() <= 100
          && request.resource.data.replies[request.resource.data.replies.size() - 1].authorPhotoUrl is string
          && request.resource.data.replies[request.resource.data.replies.size() - 1].text is string && request.resource.data.replies[request.resource.data.replies.size() - 1].text.size() > 0 && request.resource.data.replies[request.resource.data.replies.size() - 1].text.size() <= 1000
          && request.resource.data.replies[request.resource.data.replies.size() - 1].createdAt is string;
        allow delete: if false;
      }
    }

    // ----------------------------------------------------------------
    // Notification requests – created by students to inform the owner that
    // the lost item was found. Only the creator may write, and the document
    // must match the schema defined in the app.
    // ----------------------------------------------------------------
    match /notificationRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'itemId', 'recipientId', 'createdBy', 'type', 'title', 'body', 'status', 'createdAt'
        ])
        && request.resource.data.itemId == requestId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type == 'item_found'
        && request.resource.data.title == 'Seu item foi achado'
        && request.resource.data.body == 'Seu item foi achado.'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/items/$(requestId))
        && get(/databases/$(database)/documents/items/$(requestId)).data.type == 'lost'
        && get(/databases/$(database)/documents/items/$(requestId)).data.get('status', 'active') != 'recovered'
        && get(/databases/$(database)/documents/items/$(requestId)).data.userId == request.resource.data.recipientId
        && request.resource.data.recipientId != request.auth.uid;
    }

    // ----------------------------------------------------------------
    // Collection‑group query – restrict to a user's own comments.
    // ----------------------------------------------------------------
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
